{
    "name": "vs-find-all-references",
    "displayName": "FindAllReferences",
    "description": "%description%",
    "version": "1.0.5",
    "publisher": "rikpan",
    "license": "MIT",
    "icon": "media/icon.png",
    "galleryBanner": {
        "color": "#1f5fd1",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/rikpan/FindAllReferences.git"
    },
    "bugs": {
        "url": "https://github.com/rikpan/FindAllReferences/issues"
    },
    "homepage": "https://github.com/rikpan/FindAllReferences#readme",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Programming Languages",
        "Other"
    ],
    "keywords": [
        "references",
        "find all references",
        "visual studio",
        "查找所有引用",
        "csharp",
        "unity",
        "find in files",
        "查找"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/src/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "findAllReferences.findAllReferences",
                "title": "%command.findAllReferences.title%",
                "category": "%command.category%"
            },
            {
                "command": "findAllReferences.findInFiles",
                "title": "%command.findInFiles.title%",
                "category": "%command.category%"
            },
            {
                "command": "findAllReferences.nextReference",
                "title": "%command.nextReference.title%",
                "category": "%command.category%"
            },
            {
                "command": "findAllReferences.previousReference",
                "title": "%command.previousReference.title%",
                "category": "%command.category%"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "findAllReferences.findAllReferences",
                    "when": "editorHasReferenceProvider",
                    "group": "navigation@1.5"
                }
            ],
            "commandPalette": [
                {
                    "command": "findAllReferences.findAllReferences",
                    "when": "editorHasReferenceProvider"
                },
                {
                    "command": "findAllReferences.findInFiles"
                },
                {
                    "command": "findAllReferences.nextReference",
                    "when": "findAllReferences.hasResults || findAllReferences.hasFindResults"
                },
                {
                    "command": "findAllReferences.previousReference",
                    "when": "findAllReferences.hasResults || findAllReferences.hasFindResults"
                }
            ]
        },
        "keybindings": [
            {
                "command": "findAllReferences.findAllReferences",
                "key": "shift+f12",
                "when": "config.findAllReferences.useShiftF12 && editorHasReferenceProvider && editorTextFocus && !isInEmbeddedEditor"
            },
            {
                "command": "findAllReferences.findInFiles",
                "key": "ctrl+shift+f",
                "mac": "cmd+shift+f",
                "when": "config.findAllReferences.useCtrlShiftF && !(focusedView == 'findAllReferences.find' || focusedView == 'findAllReferences.findEn')"
            },
            {
                "command": "findAllReferences.findInFiles",
                "key": "ctrl+shift+f",
                "mac": "cmd+shift+f",
                "args": {
                    "seed": false
                },
                "when": "config.findAllReferences.useCtrlShiftF && (focusedView == 'findAllReferences.find' || focusedView == 'findAllReferences.findEn')"
            },
            {
                "command": "findAllReferences.nextReference",
                "key": "f4",
                "when": "config.findAllReferences.useF4Navigation && (findAllReferences.hasResults || findAllReferences.hasFindResults)"
            },
            {
                "command": "findAllReferences.previousReference",
                "key": "shift+f4",
                "when": "config.findAllReferences.useF4Navigation && (findAllReferences.hasResults || findAllReferences.hasFindResults)"
            }
        ],
        "configuration": {
            "title": "FindAllReferences",
            "properties": {
                "findAllReferences.language": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "zh-cn",
                        "en"
                    ],
                    "enumDescriptions": [
                        "%config.language.auto%",
                        "%config.language.zh-cn%",
                        "%config.language.en%"
                    ],
                    "default": "auto",
                    "order": 0,
                    "description": "%config.language%"
                },
                "findAllReferences.useShiftF12": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.useShiftF12%"
                },
                "findAllReferences.useCtrlShiftF": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.useCtrlShiftF%"
                },
                "findAllReferences.useF4Navigation": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.useF4Navigation%"
                }
            }
        },
        "viewsContainers": {
            "panel": [
                {
                    "id": "findAllReferences",
                    "title": "查找所有引用",
                    "icon": "media/icon.svg"
                },
                {
                    "id": "findAllReferencesEn",
                    "title": "Find All References",
                    "icon": "media/icon.svg"
                },
                {
                    "id": "findAllReferencesFind",
                    "title": "查找结果",
                    "icon": "media/icon.svg"
                },
                {
                    "id": "findAllReferencesFindEn",
                    "title": "Find Results",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "findAllReferences": [
                {
                    "type": "webview",
                    "id": "findAllReferences.results",
                    "name": "查找所有引用",
                    "when": "findAllReferences.locale == 'zh-cn' || !findAllReferences.locale && config.findAllReferences.language != 'en'"
                }
            ],
            "findAllReferencesEn": [
                {
                    "type": "webview",
                    "id": "findAllReferences.resultsEn",
                    "name": "Find All References",
                    "when": "findAllReferences.locale == 'en' || !findAllReferences.locale && config.findAllReferences.language == 'en'"
                }
            ],
            "findAllReferencesFind": [
                {
                    "type": "webview",
                    "id": "findAllReferences.find",
                    "name": "查找结果",
                    "when": "findAllReferences.locale == 'zh-cn' || !findAllReferences.locale && config.findAllReferences.language != 'en'"
                }
            ],
            "findAllReferencesFindEn": [
                {
                    "type": "webview",
                    "id": "findAllReferences.findEn",
                    "name": "Find Results",
                    "when": "findAllReferences.locale == 'en' || !findAllReferences.locale && config.findAllReferences.language == 'en'"
                }
            ]
        }
    },
    "scripts": {
        "compile": "node scripts/copy-codicons.js && tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
        "vscode:prepublish": "npm run compile",
        "package": "vsce package --no-dependencies",
        "publish": "vsce publish --no-dependencies",
        "icon": "node scripts/make-icon.js"
    },
    "devDependencies": {
        "@types/jsdom": "^21.1.7",
        "@types/node": "^20.17.0",
        "@types/vscode": "~1.90.0",
        "@vscode/codicons": "^0.0.36",
        "@vscode/vsce": "^3.2.0",
        "jsdom": "^25.0.1",
        "typescript": "^5.6.0"
    }
}
